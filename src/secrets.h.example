// secrets.h.example - copy to secrets.h and fill in your Wi-Fi details

#ifndef MACROCONTROLLER_SECRETS_H
#define MACROCONTROLLER_SECRETS_H

#define WIFI_SSID "your-wifi-network"
#define WIFI_PASSWORD "your-wifi-password"

// Set to 1 to use the static address below. Set to 0 for DHCP.
#define WIFI_USE_STATIC_IP 0

// Set to 1 to test the fallback access point without using a router.
#define WIFI_FORCE_AP 0

#define WIFI_STATIC_IP "192.168.1.100"
#define WIFI_GATEWAY "192.168.1.1"
#define WIFI_SUBNET "255.255.255.0"
#define WIFI_DNS_PRIMARY "8.8.8.8"
#define WIFI_DNS_SECONDARY "8.8.4.4"

#define WIFI_AP_SSID "MacroController"
#define WIFI_AP_PASSWORD "macrocontrol"

#endif
